{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "dist",
    "node_modules",
    "coverage",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock"
  ],
  "words": [
    "atproto",
    "Axelar",
    "Behaviour",
    "binancecoin",
    "bsky",
    "charlie",
    "charliebull",
    "DeFi",
    "degen",
    "dogemoji",
    "dotenv",
    "DYOR",
    "elif",
    "envfile",
    "eslintcache",
    "Fastify",
    "favourite",
    "gemini",
    "healthz",
    "Khachatryan",
    "LFGJ",
    "Linea",
    "linktr",
    "linktree",
    "loginless",
    "omnichain",
    "optimised",
    "pawsome",
    "pino",
    "pnpm",
    "Qwen's",
    "Raydium",
    "rebranded",
    "refetched",
    "setprivacy",
    "Shieldy",
    "Solana",
    "spammy",
    "supergroup",
    "supergroups",
    "Tokenomics",
    "tsnode",
    "Viktor",
    "zod"
  ],
  "flagWords": [
    // Add any words you want to be explicitly flagged even if correct
  ],
  "enableFiletypes": [
    "ts",
    "tsx",
    "js",
    "json",
    "md"
  ]
}
